# PocketBase Configuration
VITE_PB_URL=http://localhost:8090

# Optional: Admin credentials for setup
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=adminpassword123

# Optional: Salt used to hash lead IP addresses before storing them
IP_HASH_SALT=change-me

# Optional: Public site URL used in valuation emails
SITE_URL=https://rei-immobiliare.it

# Optional: SMTP settings for valuation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_FROM="REI Immobiliare <info@rei-immobiliare.it>"

# Optional: Where new valuation lead notifications should be delivered
AGENT_NOTIFICATION_EMAIL=info@rei-immobiliare.it

# Optional: CTA used in the customer valuation email
VALUATION_BOOKING_URL=tel:+390125282335
